let sq
  function (x) (mul x x)

let point (struct x y z)

let distance
  function (a, b)
    sqrt
      sum (sq (sub a.x b.x))
          (sq (sub a.y b.y))
          (sq (sub a.z b.z))

let origin (point 0 0 0)
let magnitude
  function (a)
    distance a origin
    
let some-point
  point x = 3f
        y = 22/7
        z = 157/50

print-ln "magnitude: "
         (magnitude some-point)
