PROGRAM 1:1-4:31
  CALL 1:1-2:16 iexpr
    SYMBOL 1:1-1:6 print
    STRING 1:7-1:24 "unit-ball in 2D"
    CALL 2:3-2:16 iexpr
      SYMBOL 2:3-2:14 ball-volume
      NUMBER 2:15-2:16 1
  CALL 3:1-4:31 iexpr
    SYMBOL 3:1-3:6 print
    STRING 3:7-3:24 "unit-ball in 3D"
    CALL 4:3-4:31 iexpr commas
      SYMBOL 4:3-4:14 ball-volume
      NUMBER 4:15-4:16 1
      CALL 4:18-4:31 suffix
        SYMBOL 4:28-4:29 =
        SYMBOL 4:18-4:27 dimension
        NUMBER 4:30-4:31 3
