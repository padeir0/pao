PROGRAM 1:1-12:31
  CALL 1:1-7:33 iexpr
    SYMBOL 1:1-1:4 let
    SYMBOL 1:5-1:16 ball-volume
    CALL 2:3-7:33 iexpr
      SYMBOL 2:3-2:11 function
      CALL 2:12-2:35 sexpr commas
        SYMBOL 2:13-2:19 radius
        CALL 2:21-2:34 suffix
          SYMBOL 2:31-2:32 =
          SYMBOL 2:21-2:30 dimension
          NUMBER 2:33-2:34 2
      CALL 3:5-7:33 iexpr
        SYMBOL 3:5-3:9 case
        CALL 4:7-5:27 iexpr
          CALL 4:7-4:27 sexpr
            SYMBOL 4:8-4:14 equal?
            SYMBOL 4:15-4:24 dimension
            NUMBER 4:25-4:26 2
          CALL 5:9-5:27 iexpr
            SYMBOL 5:9-5:12 mul
            SYMBOL 5:13-5:15 pi
            CALL 5:16-5:27 sexpr
              SYMBOL 5:17-5:19 sq
              SYMBOL 5:20-5:26 radius
        CALL 6:7-7:33 iexpr
          CALL 6:7-6:27 sexpr
            SYMBOL 6:8-6:14 equal?
            SYMBOL 6:15-6:24 dimension
            NUMBER 6:25-6:26 3
          CALL 7:9-7:33 iexpr
