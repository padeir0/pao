            SYMBOL 7:17-7:19 pi
            CALL 7:20-7:33 sexpr
              SYMBOL 7:21-7:25 cube
              SYMBOL 7:26-7:32 radius
  CALL 9:1-10:16 iexpr
    SYMBOL 9:1-9:6 print
    STRING 9:7-9:24 "unit-ball in 2D"
    CALL 10:3-10:16 iexpr
